// Nuflow · Regras do banco de dados do Firebase (Firestore)
// Onde colar: console.firebase.google.com > projeto nuflow-bikes > Firestore Database > Regras (Rules) > Publicar.
//
// ANTES de publicar, troque a lista ADMINS pelos e-mails de login dos administradores (sócios).
// Quem não estiver na lista continua usando o painel (estoque, vendas, clientes), mas não consegue
// ler nem alterar o Financeiro. Ao registrar uma venda, a equipe ainda consegue criar os repasses automáticos.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function admin() {
      return logado() && request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          'gestao@nuflow.com.br'
          // , 'outro.socio@email.com'
        ];
    }

    // Estoque, vendas e clientes: qualquer usuário logado
    match /bikes/{id}    { allow read, write: if logado(); }
    match /clientes/{id} { allow read, write: if logado(); }

    // Financeiro: só administradores leem, alteram e excluem.
    // A criação fica liberada para os lançamentos automáticos de cada venda.
    match /financeiro/{id} { allow create: if logado(); allow read, update, delete: if admin(); }
    match /gastos/{id}     { allow create: if logado(); allow read, update, delete: if admin(); }

    // Qualquer outra coleção: bloqueada
    match /{document=**} { allow read, write: if false; }
  }
}
